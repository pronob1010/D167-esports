# Copy this file to `.env` and fill in real values for local development.
# In production, set these as real environment variables instead.

# Required in production: a long, random, secret string.
# Generate one with:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-dev-only-key-change-me-in-production

# "True" for local development, "False" in production.
DJANGO_DEBUG=True

# Comma-separated hostnames the site is allowed to serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
