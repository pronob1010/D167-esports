# Copy this file to `.env` and fill in real values for local development.
# In production, set these as real environment variables instead.

# Required in production: a long, random, secret string.
# Generate one with:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-dev-only-key-change-me-in-production

# "True" for local development, "False" in production.
DJANGO_DEBUG=True

# Comma-separated hostnames the site is allowed to serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Email (registration notifications) -------------------------------------
# Defaults to the console backend (prints emails to the server log). For real
# delivery use the SMTP backend and fill in the host/user/password below.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=D167 <noreply@d167.local>

# --- Payments: fee per tournament -------------------------------------------
# Fee charged per tournament, in BDT (0 = free / auto-waived).
TOURNAMENT_FEE=500

# bKash Tokenized Checkout. Leave BKASH_ENABLED=False to use the built-in dummy
# gateway (no real charge) for development. Set True + credentials for real bKash.
BKASH_ENABLED=False
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
